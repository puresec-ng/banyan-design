# API base URL. Leave unset to use the built-in default
# (/api/v1 proxy in development, https://api.banyanclaims.com/api/v1 otherwise).
NEXT_PUBLIC_API_URL=

# Parent domain for auth cookies. Leave unset for banyanclaims.com.
# Set for preview/staging deployments (e.g. a vercel.app hostname).
NEXT_PUBLIC_COOKIE_DOMAIN=
